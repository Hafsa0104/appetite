# =============================================================
# Appetite — Environment variables (EXAMPLE)
# -------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
#
# .env.local is git-ignored, so real values are NEVER committed.
# Only THIS example file (with placeholders) is tracked in Git.
#
# Naming rule:
#   NEXT_PUBLIC_*  -> exposed to the browser (safe, non-secret only)
#   everything else -> server-only (keep real secrets here)
# =============================================================

# Public base URL of the deployment. Used for absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server-only secrets (never exposed to the browser) ----
# Anthropic API key for the "Help me decide" recommender.
# Used ONLY in: src/lib/recommend/anthropic.ts (server route boundary).
# Without it, the app still works and shows deterministic fallback picks.
ANTHROPIC_API_KEY=your-server-side-anthropic-key-here

# Optional: override the default recommender model (default: claude-haiku-4-5).
# ANTHROPIC_MODEL=claude-haiku-4-5