# =============================================================
# Appetite — Environment variables (EXAMPLE)
# -------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
#
# .env.local is git-ignored, so real values are NEVER committed.
# Only THIS example file (with placeholders) is tracked in Git.
#
# Naming rule:
#   NEXT_PUBLIC_*  -> exposed to the browser (safe, non-secret only)
#   everything else -> server-only (keep real secrets here)
# =============================================================

# Public base URL of the deployment. Used for absolute metadata URLs.
# In Vercel you can leave this blank locally; set it in the dashboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server-only secrets (examples — DO NOT put real keys in git) ----
# Added in a later phase when the backend/AI features arrive.
# EXAMPLE_API_KEY=your-server-side-key-here
